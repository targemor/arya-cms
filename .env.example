# App
APP_NAME=go-clean-template
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/db
# Host port of the docker Postgres (docker-compose.yml); keep PG_URL's port in step
PG_HOST_PORT=5432
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# Tracing
TRACING_ENABLED=true
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_TOKEN_EXPIRY=24h
# Content-Type Builder
SCHEMAS_DIR=./schemas
# Media Library
UPLOADS_DIR=./public/uploads
UPLOADS_PUBLIC_PATH=/uploads
UPLOADS_MAX_SIZE_MB=10
